# Telegram bot created via https://t.me/BotFather
TELEGRAM_BOT_TOKEN=replace_with_bot_token
TELEGRAM_CHAT_ID=replace_with_chat_id

# Paste the full private NSE Market Lens screener URL from your browser address bar.
SCREENER_URL=paste_your_market_lens_screener_url_here

# Alert when the screener's 1D RETURN is at or above this percentage.
THRESHOLD_PERCENT=10
ALLOW_REPEAT_ALERTS=true

# 300 seconds = 5 minutes.
CHECK_EVERY_SECONDS=300

# Local interactive defaults.
HEADLESS=false
AUTO_START=false
RUN_ONCE=false
SEND_STARTUP_MESSAGE=true
