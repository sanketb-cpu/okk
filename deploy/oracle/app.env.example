# Copy this file to the project root as .env and fill in the private values.
TELEGRAM_BOT_TOKEN=replace_with_bot_token
TELEGRAM_CHAT_ID=replace_with_chat_id
SCREENER_URL=paste_your_private_market_lens_screener_url_here

THRESHOLD_PERCENT=10
ALLOW_REPEAT_ALERTS=true
CHECK_EVERY_SECONDS=300

# Required for unattended VM operation.
HEADLESS=true
AUTO_START=true
RUN_ONCE=false
SEND_STARTUP_MESSAGE=true
